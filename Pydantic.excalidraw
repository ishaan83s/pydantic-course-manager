        {
          "id": "kFnyzwV2pWbu5WbGocN4V",
          "type": "arrow"
        }
      ],
      "updated": 1789809573241,
      "created": 1789808154487,
      "link": null,
      "locked": false,
      "text": "-> Class method is used for returning the value\nof the class not the instance.\n\nfor eg :\n\nclass Employee:\n    age = 5\n\n    @classmethod\n    def showage(cls):\n        print(f\"{cls.age}\")\n\n\ne = Employee()\ne.age = 15\n\ne.showage()",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Class method is used for returning the value\nof the class not the instance.\n\nfor eg :\n\nclass Employee:\n    age = 5\n\n    @classmethod\n    def showage(cls):\n        print(f\"{cls.age}\")\n\n\ne = Employee()\ne.age = 15\n\ne.showage()",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
