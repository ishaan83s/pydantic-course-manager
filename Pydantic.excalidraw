    {
      "id": "qD4X4CQmPR7QXn5GcDQIO",
      "type": "text",
      "x": 2224.5590837726013,
      "y": 2449.409179270662,
      "width": 1057.559326171875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1776188382,
      "version": 61,
      "versionNonce": 1210684280,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789809573241,
      "link": null,
      "locked": false,
      "text": "s = set()\ns.add(10)\ns.add(\"Jay\")\nprint(s)\n\n\ns.remove(\"Jay\") #removes particular element but if there is no element as such in the set then it gives error\nprint(s)\n\ns.pop() #pops any random element existing in set\nprint(s)\n\ns.clear() #empties the set\nprint(s)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "s = set()\ns.add(10)\ns.add(\"Jay\")\nprint(s)\n\n\ns.remove(\"Jay\") #removes particular element but if there is no element as such in the set then it gives error\nprint(s)\n\ns.pop() #pops any random element existing in set\nprint(s)\n\ns.clear() #empties the set\nprint(s)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
