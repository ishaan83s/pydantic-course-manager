      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 1418686782,
      "version": 183,
      "versionNonce": 561925128,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789809573241,
      "link": null,
      "locked": false,
      "text": "Used in DataScience and Machine Learning\n\nWe can model a matrix using a list\n\nmatrix = [\n    [1,2,3],\n    [4,5,6],\n    [7,8,9]\n]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Used in DataScience and Machine Learning\n\nWe can model a matrix using a list\n\nmatrix = [\n    [1,2,3],\n    [4,5,6],\n    [7,8,9]\n]",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ABDl1cfzRPxat_E_XxrvP",
      "type": "text",
      "x": 1485.306293694149,
      "y": 1392.2869066441428,
      "width": 673.2996826171875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 1424716030,
      "version": 402,
      "versionNonce": 1969379448,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789809573241,
      "link": null,
      "locked": false,
      "text": "Now the question is how do we access and modify the data in \n2d list?\n\n-> Access - \nmatrix[0][1] #This accesses the 1st row 2nd column i.e = 2\n-> Modify - \nmatrix[0][1] = 20 #Changes the element on      and change it to 20\ni.e 2 => 20.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now the question is how do we access and modify the data in \n2d list?\n\n-> Access - \nmatrix[0][1] #This accesses the 1st row 2nd column i.e = 2\n-> Modify - \nmatrix[0][1] = 20 #Changes the element on      and change it to 20\ni.e 2 => 20.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
