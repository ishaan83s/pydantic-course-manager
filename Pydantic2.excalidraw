      "updated": 1790684993928,
      "created": 1790683588026,
      "link": null,
      "locked": false,
      "text": "ValidationError (Basic Try Except)",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ValidationError (Basic Try Except)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "scmI6NQOhJtXBxQjubYEX",
      "type": "text",
      "x": 3621.7745954371608,
      "y": 194.35793653404897,
      "width": 637.7794799804688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7A",
      "roundness": null,
      "seed": 194719631,
      "version": 178,
      "versionNonce": 1520395873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790684842045,
      "created": 1790684791343,
      "link": null,
      "locked": false,
      "text": "ValidationError is Pydantic exception raised when validation fails.\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ValidationError is Pydantic exception raised when validation fails.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "45uCSQQD0i-ZhtjIHmt2R",
      "type": "text",
      "x": 3625.4253611250947,
      "y": 261.66284015413856,
      "width": 431.8797302246094,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7B",
      "roundness": null,
      "seed": 1064305185,
      "version": 250,
      "versionNonce": 327189573,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "jvrZqyauwIe93fP9gRLeC",
          "type": "arrow"
        }
      ],
      "updated": 1790685353765,
      "created": 1790684845931,
      "link": null,
      "locked": false,
      "text": "However This exception is not very readable\n\nso we use ->  .errors()\n\ntry :\n    product1 = Product.model_validate(data)\nexcept ValidationError as e :\n    print(e.errors())",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "However This exception is not very readable\n\nso we use ->  .errors()\n\ntry :\n    product1 = Product.model_validate(data)\nexcept ValidationError as e :\n    print(e.errors())",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "px6YyziY_sYKxi9VumNZq",
      "type": "text",
      "x": 3612.2594062848825,
      "y": 515.6473915194675,
      "width": 634.1797485351562,
      "height": 250,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7D",
      "roundness": null,
      "seed": 1627111841,
      "version": 99,
      "versionNonce": 749606795,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790687090976,
      "created": 1790685062348,
      "link": null,
      "locked": false,
      "text": "So Conceptually : \n\nValidationError\n      │\n      └── .errors()\n            │\n            ├── loc   → WHERE? [location]\n            ├── msg   → WHAT went wrong? [error msg]\n            ├── input → WHAT was supplied? [what input]\n            └── type  → WHAT kind of validation failure? [type]",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So Conceptually : \n\nValidationError\n      │\n      └── .errors()\n            │\n            ├── loc   → WHERE? [location]\n            ├── msg   → WHAT went wrong? [error msg]\n            ├── input → WHAT was supplied? [what input]\n            └── type  → WHAT kind of validation failure? [type]",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
