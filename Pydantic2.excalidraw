      "created": 1790689177603,
      "link": null,
      "locked": false,
      "text": "class User\n    │\n    ├── fields\n    │     ├── name\n    │     ├── age\n    │     └── email\n    │\n    └── model_config\n          └── rules about how User behaves",
      "fontSize": 20,
