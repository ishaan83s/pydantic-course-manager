      "index": "b0m",
      "roundness": null,
      "seed": 1772280926,
      "version": 695,
      "versionNonce": 821338744,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789809573241,
      "link": null,
      "locked": false,
      "text": "A set is a collection which is unordered , unchangeable* , and unindexed \n*Note => Set items are unchangeable, but we can remove or add new items.\n\n-> Define a set\n\nthisset = {\"apple\", \"banana\" , \"cherry\"}\n\nSet items are unordered, unchangeable , and do not allow duplicate values.\n\nA set can still store different datatypes.\n\n-> Add element into the set \nthisset = {\"apple\",\"banana\",\"mango\"}\n\nthisset.add(\"orange\")\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A set is a collection which is unordered , unchangeable* , and unindexed \n*Note => Set items are unchangeable, but we can remove or add new items.\n\n-> Define a set\n\nthisset = {\"apple\", \"banana\" , \"cherry\"}\n\nSet items are unordered, unchangeable , and do not allow duplicate values.\n\nA set can still store different datatypes.\n\n-> Add element into the set \nthisset = {\"apple\",\"banana\",\"mango\"}\n\nthisset.add(\"orange\")\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
