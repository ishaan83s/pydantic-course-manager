      "updated": 1789809573241,
      "created": 1789648315442,
      "link": null,
      "locked": false,
      "text": "class Employee: #Base class\n    #code\nclass Programmer(Employee): #Child class (derived class)\n    #code\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Employee: #Base class\n    #code\nclass Programmer(Employee): #Child class (derived class)\n    #code\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
