      "updated": 1790689189597,
      "created": 1790689036614,
      "link": null,
      "locked": false,
      "text": "We do model configuration using ConfigDict -> from pydantic import ConfigDict\nThere are 3 main configurations used :",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We do model configuration using ConfigDict -> from pydantic import ConfigDict\nThere are 3 main configurations used :",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "7A2dPfkf9AsxYBNQLbauE",
      "type": "text",
      "x": 3618.0757484512046,
      "y": 1033.7682273957473,
      "width": 486.23968505859375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7L",
      "roundness": null,
      "seed": 1315274155,
      "version": 323,
      "versionNonce": 1364318475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790689454186,
      "created": 1790689100288,
      "link": null,
      "locked": false,
      "text": "1. ConfigDict(strict = True)\n2. ConfigDict(extra = \"ignore\" / \"forbid\" / \"allow\")\n\n\n3. ConfigDict(from_attributes = True)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. ConfigDict(strict = True)\n2. ConfigDict(extra = \"ignore\" / \"forbid\" / \"allow\")\n\n\n3. ConfigDict(from_attributes = True)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DEoFCBWjWCj6ST8cmwbyQ",
      "type": "text",
      "x": 4469.934019885504,
      "y": 898.2812184313997,
