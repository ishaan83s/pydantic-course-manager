      "text": "List is a data structure that is mutable meaning its element can be changed at \nany moment. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "List is a data structure that is mutable meaning its element can be changed at \nany moment. ",
