          "id": "oxDTZbdw75ppLIzJV-BwI",
          "type": "arrow"
        }
      ],
      "updated": 1789816548119,
      "created": 1789815754921,
      "link": null,
      "locked": false,
      "text": "from pydantic import BaseModel #Mandatory\n\nclass Patient(BaseModel): #STEP 1 : Schema definition\n    name : str\n    age : int\n\npatient_info = {\n    \"name\" : \"ishaan\",\n    \"age\" : 20\n}\n\npatient1 = Patient(**patient_info) #Creating a Pydantic Object using above dictionary\n\ndef insert_patient_data(patient : Patient): #We are getting patient object Patient type(class) ka\n    print(patient.name)\n    print(patient.age)\n    print(\"inserted\")\n\ninsert_patient_data(patient1) # we need to pass a patient object and it is \"patient1\"",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from pydantic import BaseModel #Mandatory\n\nclass Patient(BaseModel): #STEP 1 : Schema definition\n    name : str\n    age : int\n\npatient_info = {\n    \"name\" : \"ishaan\",\n    \"age\" : 20\n}\n\npatient1 = Patient(**patient_info) #Creating a Pydantic Object using above dictionary\n\ndef insert_patient_data(patient : Patient): #We are getting patient object Patient type(class) ka\n    print(patient.name)\n    print(patient.age)\n    print(\"inserted\")\n\ninsert_patient_data(patient1) # we need to pass a patient object and it is \"patient1\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
