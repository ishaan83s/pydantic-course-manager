    {
      "id": "7BEyq3JgQ0qoOu1chooN_",
      "type": "text",
      "x": 284.0983948770305,
      "y": 254.3984375,
      "width": 713.219482421875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5K",
      "roundness": null,
      "seed": 1168563663,
      "version": 245,
      "versionNonce": 955494209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790671115724,
      "created": 1790669637793,
      "link": null,
      "locked": false,
      "text": "Imagine you want to:\n\nsave it to a file\nsend it through an API\nput it into JSON\nstore it somewhere\npass it to another system\n\n-> Other systems don't understand your Python Student object directly.\n\n-> They understand things like:\n\ndictionary\nJSON",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Imagine you want to:\n\nsave it to a file\nsend it through an API\nput it into JSON\nstore it somewhere\npass it to another system\n\n-> Other systems don't understand your Python Student object directly.\n\n-> They understand things like:\n\ndictionary\nJSON",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-bp3_mkD4dAwn0xMG2q4z",
      "type": "text",
      "x": 285.6468464599543,
      "y": 743.610805933074,
      "width": 563.599609375,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5M",
      "roundness": null,
      "seed": 651791791,
      "version": 298,
      "versionNonce": 146464879,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Vxrkr5bFyvC4cLxAE4U5e",
          "type": "arrow"
        }
      ],
      "updated": 1790671131790,
      "created": 1790670467849,
      "link": null,
      "locked": false,
      "text": "from pydantic import BaseModel , EmailStr , AnyUrl , Field\nfrom typing import List , Dict , Optional , Annotated\n\nclass Student(BaseModel):\n    name: str\n    age: int\n    branch: str\n\n# vivaan_dict = {\n#     \"name\" : \"Vivaan\",\n#     \"age\" : 21,\n#     \"branch\" : \"Computer Engineering\"\n# }\n\n# student1 = Student(**vivaan_dict)\n\n\n\n\nstudent = Student(\n    name=\"Ishaan\",\n    age=21,\n    branch=\"Computer Engineering\"\n)\n\nprint(student) \nprint(type(student))\n\ndata = student.model_dump()\nprint(data)\nprint(type(data))\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from pydantic import BaseModel , EmailStr , AnyUrl , Field\nfrom typing import List , Dict , Optional , Annotated\n\nclass Student(BaseModel):\n    name: str\n    age: int\n    branch: str\n\n# vivaan_dict = {\n#     \"name\" : \"Vivaan\",\n#     \"age\" : 21,\n#     \"branch\" : \"Computer Engineering\"\n# }\n\n# student1 = Student(**vivaan_dict)\n\n\n\n\nstudent = Student(\n    name=\"Ishaan\",\n    age=21,\n    branch=\"Computer Engineering\"\n)\n\nprint(student) \nprint(type(student))\n\ndata = student.model_dump()\nprint(data)\nprint(type(data))\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
