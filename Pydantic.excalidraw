      "updated": 1789809573241,
      "link": null,
      "locked": false,
      "text": "we can iterate over this matrix using nested loops \n\nfor row in matrix:\n    for item in row:\n        print(item)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we can iterate over this matrix using nested loops \n\nfor row in matrix:\n    for item in row:\n        print(item)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "CFf0mPCcPuVabba8JcFy6",
      "type": "text",
      "x": 2213.2079541406874,
      "y": 1182.3703422549734,
      "width": 1578.4189453125,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0T",
      "roundness": null,
      "seed": 2136500798,
      "version": 135,
      "versionNonce": 1949722888,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789809573241,
      "link": null,
      "locked": false,
      "text": "list = [2,1,3]\n\nlist.append(4) #adds element to the end of the list #this changes the list itself\nprint(list)\n\nlist.sort() #sorts in ascending order #this changes the list itself\nprint(list)\n\nlist.sort(reverse=True) #sorts in decending order #this changes the list itself\nprint(list)\n\nlist.reverse() #reverses the list\nprint(list)\n\nlist.insert(1,5) #list.insert(index,element)   inserts the element without replacing the og element but pushing the element og index+1 and so on with next elements\nprint(list) \n\nlist.remove(1) #remove the first occurence of the element i.e 1\nprint(list)\n\nlist.pop(2) #2 is the index #we pop the element on index 2 here\nprint(list)\n\nlist2 = list.copy()",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "list = [2,1,3]\n\nlist.append(4) #adds element to the end of the list #this changes the list itself\nprint(list)\n\nlist.sort() #sorts in ascending order #this changes the list itself\nprint(list)\n\nlist.sort(reverse=True) #sorts in decending order #this changes the list itself\nprint(list)\n\nlist.reverse() #reverses the list\nprint(list)\n\nlist.insert(1,5) #list.insert(index,element)   inserts the element without replacing the og element but pushing the element og index+1 and so on with next elements\nprint(list) \n\nlist.remove(1) #remove the first occurence of the element i.e 1\nprint(list)\n\nlist.pop(2) #2 is the index #we pop the element on index 2 here\nprint(list)\n\nlist2 = list.copy()",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
