      "updated": 1790681384854,
      "created": 1790681355377,
      "link": null,
      "locked": false,
      "text": "Validation method means : How do i turn external data into \na Pydantic Model. ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Validation method means : How do i turn external data into \na Pydantic Model. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JCgcOiTY6kVsW3qL5TQNc",
      "type": "text",
      "x": 2653.882975308231,
      "y": 271.6431943457662,
      "width": 539.8197021484375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6T",
      "roundness": null,
      "seed": 11270031,
      "version": 28,
      "versionNonce": 2135573839,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790681522129,
      "created": 1790681421334,
      "link": null,
      "locked": false,
      "text": "There are three things I want you to understand here:\n\n1. Normal model construction\n2. model_validate() \n3. model_validate_json()\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There are three things I want you to understand here:\n\n1. Normal model construction\n2. model_validate() \n3. model_validate_json()\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "toro9HDI9Q6TluCGoZ6rF",
      "type": "text",
      "x": 2656.872509908437,
      "y": 455.56414800032906,
      "width": 275.03985595703125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6V",
      "roundness": null,
      "seed": 1534404321,
      "version": 34,
      "versionNonce": 1842378671,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790681536498,
      "created": 1790681528818,
      "link": null,
      "locked": false,
      "text": "1. Normal model construction",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Normal model construction",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1gtvpjZynkihQZ1NUBhZd",
      "type": "text",
      "x": 2667.487831973615,
      "y": 501.2567622044994,
      "width": 681.4993896484375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6W",
      "roundness": null,
      "seed": 567329295,
      "version": 77,
      "versionNonce": 1315293999,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "VGT7caBkusNSsBoIAmfTd",
          "type": "arrow"
        }
      ],
      "updated": 1790681796299,
      "created": 1790681540360,
      "link": null,
      "locked": false,
      "text": "We are given a dictionary...\n\npatient_info = {'name':'nitish', 'age': '30', 'weight': 75.2, 'married': True}\npatient1 = Patient(**patient_info) #Unpacking the dictionary",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We are given a dictionary...\n\npatient_info = {'name':'nitish', 'age': '30', 'weight': 75.2, 'married': True}\npatient1 = Patient(**patient_info) #Unpacking the dictionary",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
