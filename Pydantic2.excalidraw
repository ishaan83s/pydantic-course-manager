    {
      "id": "VSHuqUE_h7l76PuQjwJxf",
      "type": "text",
      "x": 3626.327539022214,
      "y": 1280.5801879889157,
      "width": 1099.2794189453125,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7f",
      "roundness": null,
      "seed": 1104219781,
      "version": 9,
      "versionNonce": 1747345669,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Exz8EWQfLRz9VsruwTV8n",
          "type": "arrow"
        }
      ],
      "updated": 1790689568301,
      "created": 1790689438687,
      "link": null,
      "locked": false,
      "text": "\nfrom pydantic import BaseModel , ConfigDict , Field\n\nclass User(BaseModel):\n    model_config = ConfigDict(strict=True) #THIS MAKES TYPE COERSION STRICT FOR WHOLE MODEL NOT\n    #JUST A FIELD\n\n    name: str\n    age: int  # age: int = Field(strict= True) , STRICT CAN ALSO BE DONE LIKE THIS\n\n\ndata = {\n    \"name\": \"Ishaan\",\n    \"age\": \"21\",\n    \"password\": \"secret123\" # <-----\n}\n\nuser1 = User.model_validate(data)\n\nprint(user1) #doesnt print password it clearly ignores it ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nfrom pydantic import BaseModel , ConfigDict , Field\n\nclass User(BaseModel):\n    model_config = ConfigDict(strict=True) #THIS MAKES TYPE COERSION STRICT FOR WHOLE MODEL NOT\n    #JUST A FIELD\n\n    name: str\n    age: int  # age: int = Field(strict= True) , STRICT CAN ALSO BE DONE LIKE THIS\n\n\ndata = {\n    \"name\": \"Ishaan\",\n    \"age\": \"21\",\n    \"password\": \"secret123\" # <-----\n}\n\nuser1 = User.model_validate(data)\n\nprint(user1) #doesnt print password it clearly ignores it ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
