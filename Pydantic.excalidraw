    {
      "id": "76Tinh0svaGPbhgNNSpy2",
      "type": "text",
      "x": 2219.6780176348625,
      "y": 1900.0177532776752,
      "width": 730.1395874023438,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
