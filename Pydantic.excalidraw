    {
      "id": "b9lfW2_ZoYvJdMU_nz8of",
      "type": "text",
      "x": -1992.0046270515402,
      "y": -3537.4261295025926,
      "width": 571.0396118164062,
      "height": 800,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Z",
      "roundness": null,
      "seed": 408901128,
      "version": 1167,
      "versionNonce": 1451855624,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "VQZDkXbHeX4qAiF70RIfD",
          "type": "arrow"
        }
      ],
      "updated": 1789813389677,
      "created": 1789812721292,
      "link": null,
      "locked": false,
      "text": "Because , lets say we define a function :\n\ndef insert_user(name : str, age : int):\n\n    insert -> name \n    insert -> age\n\n#now imagine if a junior dev comes and tries\nto upload a user. He doesnt know what data\ntype should come for name & age.\n\nassume he ends up uploading string value\n\nbut we/database expected name -> string \nand age -> int\n\nSo to prevent this from happening we use Pydantic.\n\nHowever, one might think we can use typehinting.\nThough ,it doesnt enforce it. Meaning\nuser can still send age as string.\n\nOr enforcing rules using if else statements\nbut in PRODUCTION LEVEL CODE(interprise grade)\nthere are multiple functions that take the same input.\nSo , how many times will you enforce? and its \nnot feasible\n\nOne more reason is - what if the age entered is negative \nso how do we enforce one more layer. Therefore Pydantic \ncreates DataModels that help us.\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Because , lets say we define a function :\n\ndef insert_user(name : str, age : int):\n\n    insert -> name \n    insert -> age\n\n#now imagine if a junior dev comes and tries\nto upload a user. He doesnt know what data\ntype should come for name & age.\n\nassume he ends up uploading string value\n\nbut we/database expected name -> string \nand age -> int\n\nSo to prevent this from happening we use Pydantic.\n\nHowever, one might think we can use typehinting.\nThough ,it doesnt enforce it. Meaning\nuser can still send age as string.\n\nOr enforcing rules using if else statements\nbut in PRODUCTION LEVEL CODE(interprise grade)\nthere are multiple functions that take the same input.\nSo , how many times will you enforce? and its \nnot feasible\n\nOne more reason is - what if the age entered is negative \nso how do we enforce one more layer. Therefore Pydantic \ncreates DataModels that help us.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
