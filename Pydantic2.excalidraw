    {
      "id": "4NJfhdeeU77j3dCNvzyGs",
      "type": "text",
      "x": 5161.4074541765085,
      "y": 803.881770018298,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7s",
