      "link": null,
      "locked": false,
      "text": "#Write a program to find the largest number in a list\n\nlis = [1,2,3,4,5,6,7]\nmax = 0 \n\nfor i in lis:\n    if i > max :\n        max = i \nprint (max)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#Write a program to find the largest number in a list\n\nlis = [1,2,3,4,5,6,7]\nmax = 0 \n\nfor i in lis:\n    if i > max :\n        max = i \nprint (max)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
