      "type": "text",
      "x": 1483.7305813106377,
      "y": 1146.1582952334188,
      "width": 409.7996520996094,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
