    },
    {
      "id": "F5QCytjkWa7weUaJdTRDA",
      "type": "text",
      "x": 1391.5106843734832,
      "y": 631.0264146462179,
      "width": 736.939453125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5l",
      "roundness": null,
      "seed": 737144929,
      "version": 354,
      "versionNonce": 1822821103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790674057991,
      "created": 1790673823766,
      "link": null,
      "locked": false,
      "text": "Imagine you wanna display a students information on his profile (in an app).\nYou wont directly take whole Model and dump it into the profile.\nthere will be some data that you wanna keep private right?\n\nso we have inbuilt parameters for these :\n\n1. exclude = {}\n2. include = {}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Imagine you wanna display a students information on his profile (in an app).\nYou wont directly take whole Model and dump it into the profile.\nthere will be some data that you wanna keep private right?\n\nso we have inbuilt parameters for these :\n\n1. exclude = {}\n2. include = {}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NXaWenxOZkEhLJvPivWP6",
      "type": "text",
      "x": 1393.7927180365293,
      "y": 860.9534145804882,
      "width": 393.0997314453125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5m",
      "roundness": null,
      "seed": 384544367,
      "version": 60,
      "versionNonce": 1504278991,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790673975682,
      "created": 1790673945526,
      "link": null,
      "locked": false,
      "text": "eg: \n\nclass Student(BaseModel):\n    name: str\n    age: int\n    branch: str\n    college: str\n\nstudent.model_dump(exclude={\"college\"})",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "eg: \n\nclass Student(BaseModel):\n    name: str\n    age: int\n    branch: str\n    college: str\n\nstudent.model_dump(exclude={\"college\"})",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
