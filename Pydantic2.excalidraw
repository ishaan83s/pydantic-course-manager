    {
      "id": "jcE2sLfz50nh6pqWTY8bu",
      "type": "text",
      "x": 6386.185079656903,
      "y": 196.52221299799837,
      "width": 996.3994140625,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7x",
      "roundness": null,
      "seed": 2036093381,
      "version": 471,
      "versionNonce": 1033522533,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790692445598,
      "created": 1790692165808,
      "link": null,
      "locked": false,
      "text": "Easy concept so basically , Aliases solve a surprisingly common real-world problem:\n\nWhat if the name used by the outside world is different from the name I want to use inside Python? \n\neg : python model uses -> first_name\n     external api uses -> firstName\n\nmost of the apis use \"camelCase\" and python uses \"snake_case\".\n\n\n\nSo ,assume this pydantic model \n\nfrom pydantic import BaseModel , Field\n\nclass User(BaseModel):\n    first_name : str = Field(aliase = firstName)\n    last_name : str = Field(aliase = lastName)\n    age : int\n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Easy concept so basically , Aliases solve a surprisingly common real-world problem:\n\nWhat if the name used by the outside world is different from the name I want to use inside Python? \n\neg : python model uses -> first_name\n     external api uses -> firstName\n\nmost of the apis use \"camelCase\" and python uses \"snake_case\".\n\n\n\nSo ,assume this pydantic model \n\nfrom pydantic import BaseModel , Field\n\nclass User(BaseModel):\n    first_name : str = Field(aliase = firstName)\n    last_name : str = Field(aliase = lastName)\n    age : int\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
