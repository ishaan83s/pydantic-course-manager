    {
      "id": "JhKDfpbu4vHYpYRXG2twk",
      "type": "text",
      "x": 384.21504898266375,
      "y": 3390.1196721749875,
      "width": 500.2396545410156,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1E",
