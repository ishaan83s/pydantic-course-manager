      "seed": 68659047,
      "version": 415,
      "versionNonce": 1635710984,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789809573241,
      "link": null,
      "locked": false,
      "text": "#How to create a class\n\nclass tyrianlanister():\n    first_name = \"tyrion\"\n    last_name = \"lanister\"\n    height = \"3 feet\"\n    nickname = \"imp\"\n\ntyrion = tyrionlanister()  #Here tyrion is an object \n#of class tyrionlanister (that flws the blueprint) \n\nprint(tyrion.first_name , tyrion.last_name) \n\n\n#This prints \"tyrion lanister\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#How to create a class\n\nclass tyrianlanister():\n    first_name = \"tyrion\"\n    last_name = \"lanister\"\n    height = \"3 feet\"\n    nickname = \"imp\"\n\ntyrion = tyrionlanister()  #Here tyrion is an object \n#of class tyrionlanister (that flws the blueprint) \n\nprint(tyrion.first_name , tyrion.last_name) \n\n\n#This prints \"tyrion lanister\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
